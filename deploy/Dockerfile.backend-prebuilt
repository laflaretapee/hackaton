# Optional deployment path: compile linux/amd64 locally to reduce VPS memory use.
# From repository root:
# CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -C backend -o ../.deploy/ai-buddy .
FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 10001 buddy
WORKDIR /app
COPY .deploy/ai-buddy /app/ai-buddy
USER buddy
EXPOSE 8080
ENTRYPOINT ["/app/ai-buddy"]
